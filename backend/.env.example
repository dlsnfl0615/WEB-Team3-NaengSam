DATABASE_URL=
DATABASE_DRIVER=
DATABASE_USER=
DATABASE_PASSWORD=

SOLAPI_ENABLED=
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_FROM=

KAKAO_REST_API_KEY=
KAKAO_ENABLED=

BUCKET_NAME=
AWS_REGION=
UPLOAD_S3_ENABLED=

LOG_LEVEL=info

# 웹푸시(VAPID). 비워두면 푸시 비활성으로 동작한다. 키 생성: npx web-push generate-vapid-keys
WEB_PUSH_ENABLED=true
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=
# 드리미 장시간 무소식 안내 문자(유료). 기본 false. 로컬 확인은 SOLAPI_ENABLED=false 와 함께 켜면
# DevSmsSender 가 문자 대신 로그만 남긴다. 실제 발송은 실제 번호로 수동 E2E 를 통과한 뒤에만 켠다.
SMS_FALLBACK_ENABLED=false
LOG_LEVEL=debug

# 로그인 대기열용 Redis. 로컬은 비워두면 localhost:6379 로 붙는다.
# 운영은 REDIS_PASSWORD 를 반드시 채운다(Redis 인스턴스 보안그룹 제한과 한 세트).
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=

# 적혀있는 값은 기본 값이다.
OFFER_QUOTA_MODE=DYNAMIC
ASSIGNMENT_POLICY=SCORE_BASED_GREEDY
SCORING_POLICY=BALANCED
ELIGIBILITY_POLICY=OUTCOME_COOLDOWN
DYNAMIC_QUOTA_MAX=5
