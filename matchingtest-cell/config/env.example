# 매칭 부하테스트 설정. `cp config/env.example config/.env.local` 후 값을 바꿔 쓰세요.
# run.mjs가 ENV_FILE(기본 ./config/.env.local)을 읽습니다. 셸에서 준 환경변수가 파일보다 우선합니다.

# ── 대상 ────────────────────────────────────────────────────────────
API_BASE=http://localhost:8080          # 부하를 거는 API 경로
WEB_BASE=http://localhost:5173          # Playwright가 여는 프론트 경로
DB_KIND=h2                              # h2 | mysql
DB_URL=jdbc:h2:tcp://localhost/~/test;MODE=MySQL
DB_USER=sa
DB_PASSWORD=
JDBC_JARS=                              # 비우면 ~/.gradle 캐시에서 자동 탐색

# ── 계정 확보 방식 ──────────────────────────────────────────────────
# 기본은 시드 INSERT. 운영처럼 쓰기가 막힌 DB에는 1로 두고 이미 있는 계정을 SELECT로 끌어 쓴다.
USE_EXISTING_ACCOUNTS=0
EXISTING_EMAIL_LIKE=%@test.local   # 재사용할 계정을 고르는 SQL LIKE 패턴
EXISTING_PASSWORD=                 # 그 계정들의 공통 평문 비밀번호. DB 해시로는 복원 불가라 직접 줘야 한다.

# ── 좌표 분포 (matchingtest-cell 전용) ──────────────────────────────
# 원본 matchingtest는 드리미도 주문도 강남 한 곳에 몰아넣는다. 이 폴더는 드리미와 부르미를 같은
# 존 목록(서울 강남 + 지방 16개 도시)에 라운드로빈으로 함께 뿌려 전국 단위 상황을 만든다.
#
# ⚠ 백엔드도 짝을 맞춰 띄워야 한다. 주문 좌표는 하네스가 못 정한다 — OrderRequest는 도로명주소만 받고
#   좌표는 DevCoordinatesService가 만든다. KAKAO_DEV_ZONE_MODE=national 로 띄워야 주소 첫 토큰(도시명)을
#   보고 그 도시에 주문을 떨어뜨린다. 기본값(gangnam)으로 띄우면 주문이 전부 강남에 몰려 지방 주문이
#   통째로 굶는다 — run.mjs가 실행 전에 서울→부산 견적 거리로 이 설정을 검사하고 어긋나면 중단한다.
#
#   KAKAO_ENABLED=false KAKAO_DEV_ZONE_MODE=national ./gradlew bootRun
DIST_MODE=national      # national=전국 17개 존 분산 / local=원본과 동일(전원 강남)
CENTER_LAT=37.4979      # 서울 강남 존 중심. 브라우저 계정 좌표와 맞춘 값이라 바꿀 일이 없다.
CENTER_LNG=127.0276
SPREAD_DEG=0.01         # 도시 하나 안에서의 지터 반경(도). 0.01 ≈ 위도 1.1km.

# ── 규모 ────────────────────────────────────────────────────────────
DREAMI_COUNT=400        # 온라인 드리미 계정 수. 완주 상한이기도 하다. (수집 모드에서는 수집 상한)
                        # 전국 분산이면 17개 존에 고르게 나뉜다(400 → 존당 약 23명).
BOORMI_COUNT=400        # 주문을 만드는 부르미 계정 수
ORDER_COUNT=100         # 총 생성 주문 수
ORDER_RATE=5            # 초당 주문 생성 수. 백엔드가 KAKAO_ENABLED=false면 외부 호출이 없어 여유가 있다.
LOGIN_CONCURRENCY=10    # 동시 로그인 수. 세션 생성이 몰리면 톰캣 스레드가 먼저 마른다.
LOGIN_QUEUE_TIMEOUT_MS=120000
                        # 로그인이 대기열(#399)에 걸렸을 때 차례를 기다리는 상한. 서버 티켓 TTL(2분)을
                        # 넘겨 기다려 봐야 만료 응답만 받는다. 대기열이 없는 서버에서는 쓰이지 않는다.
ACCEPT_DELAY_MS=0       # 오퍼 수신 후 수락까지 지연. 30000 이상이면 오퍼 TTL을 넘긴다.
DURATION_MS=360000      # 주문 생성이 끝난 시점부터 재는 최대 대기 시간(램프는 포함되지 않는다).
                        # 배달까지 태우면 오퍼 지연 + ACCEPT_DELAY_MS + PICKUP_MS_MAX + DELIVER_MS_MAX를
                        # 덮어야 한다. 짧으면 긴 배달이 잘려 '배달 미완주'로 오판된다.
DRAIN_MS=20000          # 마지막 이벤트를 기다리는 시간. 짧으면 정상 이벤트를 유실로 오판한다.

# ── 배달 단계 ────────────────────────────────────────────────────────
# 매칭이 끝난 주문을 실제 배달 완료까지 몰고 가서, 동시에 진행되는 배달 건수를 얼마나 버티는지 잰다.
# 동시 배달 ≈ ORDER_RATE × 평균 배달 소요 시간. DREAMI_COUNT가 그 상한이다
# (매칭된 드리미는 주문이 끝날 때까지 다시 온라인이 될 수 없다).
DELIVERY=1                # 0이면 기존처럼 매칭 확정까지만 측정
LOCATION_INTERVAL_MS=5000 # 드리미 위치 전송 주기. 진행 중 배달 수 × (1/주기)가 지속 부하다. 0이면 폴링 없음.
                          # 0으로는 GPS 끊김 감지를 재현할 수 없다 — 서버가 '첫 위치가 아직 안 온 배달'을
                          # 제외하므로(DeliveryRepository.findStaleLocationDeliveries), 끊김을 보려면
                          # 주기를 임계값(30초)보다 길게 둬서 한 번 보내고 끊는 형태로 만들어야 한다.
PICKUP_MS_MIN=20000       # 배달 시작 → 픽업 완료. 건별로 이 범위에서 균등분포로 뽑는다
PICKUP_MS_MAX=90000
DELIVER_MS_MIN=30000      # 픽업 완료 → 배달 완료. 건별 랜덤
DELIVER_MS_MAX=180000
T_DELIVERING=10000        # pickup-finish 200 → 부르미에게 delivery_delivering
T_COMPLETED=10000         # finish 200 → 부르미에게 delivery_completed

# ── 실클라이언트 검증 ───────────────────────────────────────────────
WATCH=1                 # Playwright를 부하와 동시에 실행
WATCH_DREAMI=10
WATCH_BOORMI=10
HEADED=0                # 1이면 창을 띄운다. 20창은 격자가 화면을 넘어가니 헤드리스로 둔다
WATCH_TIMEOUT_MS=60000
WATCH_CONCURRENCY=4     # 창을 동시에 몇 개까지 띄울지. 올릴수록 빠르지만 로그인 타임아웃 위험
# 매칭을 이긴 드리미 창은 화면을 눌러 배달을 완주시키고, 부르미 창은 완료 화면 도달까지 단언한다.
# 아래 대기는 부하의 PICKUP_MS_*/DELIVER_MS_*와 별개다 — 이 창이 재는 것은 배달 소요 시간이 아니라
# 화면이 끝까지 동작하는지다. 길게 두면 부하 구간과 겹쳐 서버 지표에 잡음만 얹는다.
WATCH_PICKUP_MS=2000    # 배달 시작 → "픽업 완료" 클릭까지
WATCH_DELIVER_MS=2000   # 픽업 완료 → "전달 완료" 클릭까지
# 부르미 창이 완료 화면을 기다리는 시간. 상대가 부하 드리미면 PICKUP_MS_MAX + DELIVER_MS_MAX만큼
# 걸리므로 그 합보다 넉넉해야 한다. 타임아웃 실패는 프론트 결함이 아닐 수 있어 리포트가 원인을 가른다.
WATCH_DELIVERY_TIMEOUT_MS=300000

# ── 유실 판정 타임아웃(ms) ──────────────────────────────────────────
T_OFFER=15000           # 주문 생성 → offer_popup
T_INFO=10000            # 드리미 수락 → dreami_info
T_CLOSED=10000          # 수락 확정 → 형제 오퍼 offer_closed
T_DELIVERY=10000        # 부르미 확정 → delivery_started_*
T_EXPIRE=45000          # 무응답 오퍼 → TTL 30초 만료 offer_closed

# ── 정리 ────────────────────────────────────────────────────────────
# 활성 주문 1건이 부르미 1명과 드리미 1명을 동시에 잠근다. 정리하지 않으면 곧 쓸 계정이 없어진다.
# DELIVERY=0이면 주문이 IN_PROGRESS로 남고, DELIVERY=1이면 완료된 주문은 COMPLETED가 되어 잠금이 풀린다.
# 단 픽업만 끝나고 완료를 못 한 주문(DELIVERY_CD=DELIVERING)은 어떤 취소 API로도 되돌릴 수 없어
# 그 계정 두 개가 영구히 잠긴다 — 리포트가 목록으로 알려주니 DB에서 직접 치워야 한다.
CLEANUP=1               # 리포트를 낸 뒤 이번 런이 만든 주문을 부르미 본인 세션으로 취소
CLEANUP_CONFIRM=0       # --only=cleanup 전용. 0이면 대상만 보여주는 dry-run

# ── 안전장치 ────────────────────────────────────────────────────────
RESET_DB=1              # 실행 전 시드 계정과 그 계정의 주문만 삭제
ALLOW_REMOTE_RESET=0    # DB_URL이 localhost가 아닐 때 초기화하려면 1이 필요
REMOTE_DB=0             # 1이면 DB를 무조건 원격으로 본다. SSH 터널은 호스트가 127.0.0.1로 보여
                        # 위 가드가 그냥 통과하므로, 터널을 쓸 때는 반드시 1로 둔다.
KAKAO_CHECK=1           # 백엔드가 카카오 스텁(KAKAO_ENABLED=false)으로 떠 있는지 확인하고, 아니면 중단
CORS_CHECK=1            # 프론트와 API가 같은 오리진인 배포 대상은 0. 서버가 CORS 헤더를 안 줘 거짓 실패한다.
